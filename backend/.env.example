# --- Postgres (self-hosted in the compose stack) ---
POSTGRES_USER=jawaab
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=jawaab
# DATABASE_URL is assembled from the above for the app container.
DATABASE_URL=postgresql+psycopg://jawaab:change-me-strong@postgres:5432/jawaab

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=30
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=de.jawaab.app
APPLE_ISSUER=https://appleid.apple.com

# --- Caching ---
PUBLIC_CACHE_TTL=86400

# --- Domain (leave blank to serve plain HTTP on the Droplet IP) ---
API_DOMAIN=

# --- Migration (one-time, from existing Supabase project) ---
SUPABASE_URL=https://zivxfntpaajrlvyscqka.supabase.co
SUPABASE_SERVICE_KEY=
